{
  "name": "dsh-siwc",
  "version": "0.1.3",
  "description": "Sign in with ChatGPT for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness"
  ],
  "homepage": "https://github.com/ph0ryn/dsh-siwc#readme",
  "bugs": {
    "url": "https://github.com/ph0ryn/dsh-siwc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph0ryn/dsh-siwc.git"
  },
  "license": "MIT",
  "author": "ph0ryn",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    },
    "./client": {
      "default": "./dist/client/client.cjs"
    }
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist/client",
    "dist/server",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepack": "pnpm run build && clean-pkg-json --keep dsh",
    "prepare": "vp config --hooks --no-agent",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "openai": "^7.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.3.1",
    "clean-pkg-json": "^2.0.0",
    "jose": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "sort-package-json": "^4.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-authorization": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-web": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
