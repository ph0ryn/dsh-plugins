{
  "name": "dsh-plugins",
  "private": true,
  "description": "DeepSeek Harness plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph0ryn/dsh-siwc.git"
  },
  "license": "MIT",
  "author": "ph0ryn",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "vp config --hooks --no-agent",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "clean-pkg-json": "catalog:",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
