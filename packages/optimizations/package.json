{
  "name": "@ph0ryn/dsh-optimizations",
  "version": "0.1.0",
  "description": "Small individually switchable improvements for DeepSeek Harness across the Web GUI and host behaviour",
  "keywords": [
    "dsh",
    "deepseek-harness"
  ],
  "homepage": "https://github.com/ph0ryn/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/ph0ryn/dsh-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph0ryn/dsh-plugins.git"
  },
  "license": "MIT",
  "author": "ph0ryn",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    },
    "./client": {
      "default": "./dist/client/client.cjs"
    }
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist/client",
    "dist/server",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "vp pack && node src/dist.check.ts",
    "prepack": "pnpm run build && clean-pkg-json --keep dsh",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh-app-boot": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-config-editor": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "react": "catalog:",
    "react-test-renderer": "catalog:",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
