{
  "name": "dsh-siwc",
  "version": "0.1.3",
  "description": "Sign in with ChatGPT for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness"
  ],
  "homepage": "https://github.com/ph0ryn/dsh-siwc#readme",
  "bugs": {
    "url": "https://github.com/ph0ryn/dsh-siwc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph0ryn/dsh-siwc.git"
  },
  "license": "MIT",
  "author": "ph0ryn",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    },
    "./client": {
      "default": "./dist/client/client.cjs"
    }
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist/client",
    "dist/server",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build && clean-pkg-json --keep dsh",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "openai": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-app-boot": "catalog:",
    "@deepseek-ai/dsh-atomic-write": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-authorization": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-config-editor": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-credentials-local": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:",
    "@deepseek-ai/dsh-web": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "jose": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-test-renderer": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-authorization": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-web": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
